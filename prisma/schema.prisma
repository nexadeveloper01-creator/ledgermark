// LEDGERMARK — 전자담배 유통 공정관리 플랫폼
// UID 소유권 상태머신 + 허가형 원장(해시체인 시뮬레이션) 데이터 모델

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrgType {
  PRODUCER // 생산법인
  IMPORTER // 수입사
  DISTRIBUTOR // 지역총판
  RETAILER // 소매 매장
  GOVERNMENT // 정부기관 (관세청/DTI 등)
  LEDGER_OPERATOR // 블록체인 신뢰 레이어 운영 주체
  MARKETING // 브랜드·마케팅 계열사
}

enum UidStatus {
  MINTED
  EXPORTED
  WHOLESALE
  RETAIL_SOLD
  EXCHANGED
  RESOLD
}

enum OwnerType {
  ORG
  CONSUMER
}

enum VoucherState {
  NONE
  AVAILABLE
  USED
  VOID
}

enum TxType {
  MINT
  EXPORT_TRANSFER
  WHOLESALE_TRANSFER
  RETAIL_SALE
  EXCHANGE_TRANSFER
  RESALE_TRANSFER
}

enum AlertStatus {
  OPEN
  RESOLVED
}

enum UserRole {
  ADMIN // 플랫폼 운영자 — LOT 발급, 원장 운영
  GOV_INSPECTOR // 관세청·DTI 심사관 — 관제 콘솔
  FIELD_OFFICER // 경찰·단속관 — 현장 단말
  PARTNER_STAFF // 매장·총판 직원 — 소유권 이전 커밋
  CONSUMER // 소비자 — 앱
}

// 기관 직원과 소비자를 하나의 계정 테이블로 다루되, 소속으로 구분한다.
// 직원 계정은 organizationId를, 소비자 계정은 consumerId를 갖는다.
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  role         UserRole

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  consumerId String?   @unique
  consumer   Consumer? @relation(fields: [consumerId], references: [id])

  // 소속 기관의 직원 계정을 관리할 수 있는 권한. 역할과 직교하는 속성이라
  // 별도 역할을 만들지 않고 플래그로 둔다(관리자도 평소 업무는 동일하게 수행한다).
  // 이 플래그 부여는 운영자만 할 수 있다.
  isOrgManager Boolean @default(false)

  // 이메일 소유 확인 시점. 미인증 계정은 정품 등록 신청을 할 수 없다.
  emailVerifiedAt DateTime?

  // 감사 로그가 계정을 참조하므로 삭제하지 않고 비활성화한다.
  disabledAt DateTime?

  createdAt DateTime   @default(now())
  sessions  Session[]
  auditLogs AuditLog[]
  tokens    VerificationToken[]
}

// 세션 토큰 원문은 저장하지 않고 해시만 보관한다 (DB 유출 시 세션 탈취 방지).
model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// 메일로 보내는 일회용 토큰. 원문은 저장하지 않고 해시만 보관하며,
// 사용 시각을 남겨 재사용을 막는다.
model VerificationToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  type      TokenType
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, type])
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILED
  LOGIN_BLOCKED
  LOGOUT
  LOT_MINTED
  UID_TRANSFERRED
  REQUEST_CREATED
  REQUEST_COMMITTED
  REQUEST_REJECTED
  AGE_VERIFICATION
  CONSUMER_LOOKUP
  FIELD_INSPECTION
  FIELD_REPORT_ISSUED
  ALERT_CREATED
  ALERT_RESOLVED
  ANCHOR_RUN
  USER_CREATED
  USER_DISABLED
  USER_ENABLED
  USER_PASSWORD_RESET
  USER_SESSIONS_REVOKED
  USER_SIGNUP
  EMAIL_VERIFY_SENT
  EMAIL_VERIFIED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED
}

// 감사 로그 — append-only. 수정·삭제 경로를 두지 않으며 열람은 감독기관·운영자로 제한한다.
// 원본 신분정보나 비밀번호 등 민감정보는 detail에 담지 않는다.
model AuditLog {
  id     String      @id @default(cuid())
  action AuditAction

  actorUserId String?
  actorUser   User?     @relation(fields: [actorUserId], references: [id])
  actorEmail  String? // 로그인 실패처럼 계정이 특정되지 않는 경우를 위해 별도 보관
  actorRole   UserRole?

  targetType String?
  targetId   String?

  ip        String?
  userAgent String?
  detail    Json?

  createdAt DateTime @default(now())

  @@index([action, createdAt])
  @@index([actorUserId])
}

// 레이트 리밋 카운터. 프로세스 메모리가 아니라 DB에 두어 재시작·다중 인스턴스에서도
// 브루트포스 시도 횟수가 유지되도록 한다.
model RateLimitEntry {
  id           String    @id @default(cuid())
  key          String    @unique
  hits         Int       @default(0)
  windowStart  DateTime  @default(now())
  blockedUntil DateTime?
  updatedAt    DateTime  @updatedAt
}

enum RequestType {
  RETAIL_SALE
  EXCHANGE_TRANSFER
  WHOLESALE_TRANSFER
}

enum RequestStatus {
  PENDING
  COMMITTED
  BLOCKED
  REJECTED
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  type      OrgType
  country   String
  createdAt DateTime @default(now())

  lotsProduced     Lot[]               @relation("Producer")
  uidsOwned        Uid[]               @relation("OrgOwner")
  ledgerTxAsFrom   LedgerTransaction[] @relation("FromOrg")
  ledgerTxAsTo     LedgerTransaction[] @relation("ToOrg")
  requestsAsFrom   TransferRequest[]   @relation("RequestFromOrg")
  requestsAsTo     TransferRequest[]   @relation("RequestToOrg")
  users            User[]
}

model Consumer {
  id          String   @id @default(cuid())
  displayName String
  country     String
  createdAt   DateTime @default(now())

  ageVerifications AgeVerification[]
  uidsOwned        Uid[]               @relation("ConsumerOwner")
  ledgerTxAsFrom   LedgerTransaction[] @relation("FromConsumer")
  ledgerTxAsTo     LedgerTransaction[] @relation("ToConsumer")
  transferRequests TransferRequest[]
  user             User?

  pointAccount      PointAccount?
  surveyResponses   SurveyResponse[]
  rewardRedemptions RewardRedemption[]
  consent           ConsentRecord?
  consentEvents     ConsentEvent[]
  coupons           Coupon[]
  exchangeBonus     ExchangeBonus?
}

// 연령인증 — 원본 신분정보는 저장하지 않고 "검증 결과 크리덴셜"만 기록한다 (기획서 3.3)
model AgeVerification {
  id             String   @id @default(cuid())
  consumerId     String
  consumer       Consumer @relation(fields: [consumerId], references: [id])
  country        String
  method         String
  verified       Boolean
  credentialHash String
  verifiedAt     DateTime @default(now())
}

model Lot {
  id            String       @id @default(cuid())
  code          String       @unique
  productName   String
  quantity      Int
  producerOrgId String
  producer      Organization @relation("Producer", fields: [producerOrgId], references: [id])
  producedAt    DateTime     @default(now())

  uids Uid[]
}

model Uid {
  id     String @id @default(cuid())
  code   String @unique
  lotId  String
  lot    Lot    @relation(fields: [lotId], references: [id])

  status       UidStatus
  ownerType    OwnerType
  ownerOrgId   String?
  ownerOrg     Organization? @relation("OrgOwner", fields: [ownerOrgId], references: [id])
  ownerConsumerId String?
  ownerConsumer   Consumer?  @relation("ConsumerOwner", fields: [ownerConsumerId], references: [id])

  voucherState VoucherState @default(NONE)

  // EXCHANGE_TRANSFER 발급 시 구UID -> 신UID 연결 (교환 이력 추적용)
  replacesUidId String? @unique
  replacesUid   Uid?    @relation("UidExchange", fields: [replacesUidId], references: [id])
  replacedBy    Uid?    @relation("UidExchange")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions LedgerTransaction[]
  alerts       SmuggleAlert[]
  requests     TransferRequest[]
  inspections  FieldInspection[]
  kioskSales   KioskSale[]

  @@index([status])
}

// 무인 자판기 판매 → 소비자 앱 클레임(자동 소유권 이전) 연결.
// 결제/배출 시 claimCode를 발급하고, 소비자가 앱에서 스캔하면 RETAIL_SALE로 자동 커밋된다.
model KioskSale {
  id                String    @id @default(cuid())
  uidId             String
  uid               Uid       @relation(fields: [uidId], references: [id])
  claimCode         String    @unique
  status            String    @default("PENDING") // PENDING | CLAIMED
  orgId             String? // 배출 시점 UID 보유 조직(총판/매장)
  claimedConsumerId String?
  createdAt         DateTime  @default(now())
  claimedAt         DateTime?

  @@index([status])
}

// 그룹 허가형 원장 — append-only, 해시체인으로 무결성 보장(퍼블릭 앵커링은 Anchor 모델로 시뮬레이션)
model LedgerTransaction {
  id       String @id @default(cuid())
  sequence Int    @unique @default(autoincrement())

  uidId String
  uid   Uid    @relation(fields: [uidId], references: [id])
  txType TxType

  fromOwnerType  OwnerType?
  fromOrgId      String?
  fromOrg        Organization? @relation("FromOrg", fields: [fromOrgId], references: [id])
  fromConsumerId String?
  fromConsumer   Consumer?     @relation("FromConsumer", fields: [fromConsumerId], references: [id])

  toOwnerType  OwnerType
  toOrgId      String?
  toOrg        Organization? @relation("ToOrg", fields: [toOrgId], references: [id])
  toConsumerId String?
  toConsumer   Consumer?     @relation("ToConsumer", fields: [toConsumerId], references: [id])

  metadata  Json?
  prevHash  String
  hash      String
  createdAt DateTime @default(now())

  @@index([uidId])
}

enum AnchorStatus {
  PENDING // 로컬 Merkle 루트 계산 완료, 퍼블릭 체인 미게시
  PUBLISHED // 퍼블릭 체인 트랜잭션 확정
  FAILED // 게시 시도 실패 — 재시도 가능
}

// 주기적 Merkle 앵커링. 퍼블릭 체인 게시 실패가 원장 기록을 막아서는 안 되므로
// 루트 계산·저장과 체인 게시를 분리하고, 게시 상태를 별도로 추적한다.
model Anchor {
  id String @id @default(cuid())
  // 동시에 실행된 스케줄러가 같은 구간을 중복 앵커링하지 못하도록 DB가 막는다.
  // 경쟁하는 쪽은 unique 위반으로 실패하고 조용히 종료된다.
  fromSequence Int    @unique
  toSequence   Int
  txCount      Int
  merkleRoot   String

  status          AnchorStatus @default(PENDING)
  publicAnchorRef String? // 퍼블릭 체인 트랜잭션 해시
  chainId         Int?
  blockNumber     BigInt?
  publishedAt     DateTime?
  lastError       String?

  createdAt DateTime @default(now())

  @@index([status])
}

// 소유권 이전 대기 큐 — 소비자 앱이 스캔·연령인증으로 요청을 올리면,
// UID를 실제로 보유한 매장/총판이 매장 웹에서 커밋해 원장 트랜잭션이 기록된다.
model TransferRequest {
  id     String        @id @default(cuid())
  uidId  String
  uid    Uid           @relation(fields: [uidId], references: [id])
  type   RequestType
  status RequestStatus @default(PENDING)

  requestedConsumerId String?
  requestedConsumer   Consumer? @relation(fields: [requestedConsumerId], references: [id])

  fromOrgId String?
  fromOrg   Organization? @relation("RequestFromOrg", fields: [fromOrgId], references: [id])
  toOrgId   String?
  toOrg     Organization? @relation("RequestToOrg", fields: [toOrgId], references: [id])

  ageVerified   Boolean @default(false)
  blockedReason String?

  createdAt   DateTime  @default(now())
  committedAt DateTime?

  @@index([status])
}

// 원장에 존재하지 않는 UID(위조 의심)도 알림 대상이므로 uidCode를 항상 보관하고
// 원장 레코드와의 연결(uidId)은 선택적으로 둔다.
model SmuggleAlert {
  id         String      @id @default(cuid())
  uidCode    String
  uidId      String?
  uid        Uid?        @relation(fields: [uidId], references: [id])
  reason     String
  status     AlertStatus @default(OPEN)
  detectedAt DateTime    @default(now())
  resolvedAt DateTime?
}

enum FieldVerdict {
  VERIFIED // 정품 · 정상 유통
  SEIZURE_GROUNDS // 통관 미확인 · 압수 근거 성립
  COUNTERFEIT_SUSPECTED // 원장 미존재 · 위조 의심
}

// ── 소비자 포인트/리워드 ──────────────────────────────────────────────
// 포인트는 현금을 대신하는 가치를 지니므로 잔액을 임의로 바꾸지 않고,
// 모든 적립·차감을 append-only 원장(PointLedgerEntry)으로만 기록한다.
// 잔액은 원장 합계를 물리화한 값이며 dedupeKey로 중복 적립을 DB가 막는다.

enum PointReason {
  DEVICE_REGISTRATION // 정품(기기) 등록
  WEEKLY_CHECKIN // 주간 접속 출석
  STREAK_BONUS // 연속 출석 보너스
  SURVEY_COMPLETION // 설문·질문 응답
  PROFILE_COMPLETION // 프로필 정보 입력
  CONSENT_REWARD // 개인정보 수집·활용 동의 보상
  SIGNUP_BONUS // 가입 축하
  REWARD_REDEMPTION // 경품·콘텐츠 사용(차감)
  ADJUSTMENT // 운영자 수동 조정
}

enum RewardType {
  CONTENT // 앱 내 콘텐츠 해금
  PRIZE_DRAW // 경품 응모
  GIFT // 상품 교환
  DISCOUNT // 구매 할인 쿠폰
}

enum RedemptionStatus {
  REQUESTED
  FULFILLED
  CANCELLED
}

// 동의 스코프별 보상 정책은 서비스 코드(consentService)에서 관리한다.
enum DiscountKind {
  PERCENT // 정률 할인(%)
  AMOUNT // 정액 할인(페소)
}

enum CouponStatus {
  ISSUED // 발급됨(미사용)
  USED // 사용 완료
  EXPIRED // 만료
}

// 개인정보 수집·활용 동의 — 스코프별 현재 상태(동의 기반 데이터 활용의 근거).
// 변경 이력은 append-only ConsentEvent에 남긴다.
model ConsentRecord {
  id         String   @id @default(cuid())
  consumerId String   @unique
  consumer   Consumer @relation(fields: [consumerId], references: [id])
  profile    Boolean  @default(false) // 프로필(연령대·지역 등)
  usage      Boolean  @default(false) // 제품 사용 습관
  location   Boolean  @default(false) // 위치 기반
  marketing  Boolean  @default(false) // 맞춤 광고·마케팅 활용
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// 동의/철회 이력 — append-only 감사 기록.
model ConsentEvent {
  id         String   @id @default(cuid())
  consumerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id])
  scope      String // profile | usage | location | marketing
  granted    Boolean // true=동의, false=철회
  createdAt  DateTime @default(now())

  @@index([consumerId, createdAt])
}

// 포인트로 발급받은 구매 할인 쿠폰.
model Coupon {
  id         String       @id @default(cuid())
  code       String       @unique
  consumerId String
  consumer   Consumer     @relation(fields: [consumerId], references: [id])
  rewardId   String?
  reward     Reward?      @relation(fields: [rewardId], references: [id])
  kind       DiscountKind
  value      Int // PERCENT면 %, AMOUNT면 페소
  status     CouponStatus @default(ISSUED)
  issuedAt   DateTime     @default(now())
  expiresAt  DateTime?
  usedAt     DateTime?
  checkout   StoreCheckout?

  @@index([consumerId, status])
}

// 추가 무상 교환 자격 사용 기록. 자격(전체 설문 완료 + 정보 이용 동의)은 실시간으로
// 판정하고, 이 모델은 "추가 교환 1회를 이미 소진했는지"만 추적한다(consumer당 1회).
model ExchangeBonus {
  id         String    @id @default(cuid())
  consumerId String    @unique
  consumer   Consumer  @relation(fields: [consumerId], references: [id])
  usedAt     DateTime? // 사용 시각(소진). null이면 미사용.
  usedUidId  String? // 어느 UID에 추가 교환권을 부여했는지
  createdAt  DateTime  @default(now())
}

// 매장 결제(POS) 기록 — 쿠폰 차감이 실제 결제에 반영된 근거. 쿠폰 1장당 결제 1건.
model StoreCheckout {
  id          String   @id @default(cuid())
  orgId       String?
  staffUserId String?
  consumerId  String?
  amount      Int // 정가(페소)
  discount    Int // 할인액(페소)
  total       Int // 실제 결제액(페소)
  couponId    String?  @unique
  coupon      Coupon?  @relation(fields: [couponId], references: [id])
  couponCode  String?
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
}

model PointAccount {
  id              String    @id @default(cuid())
  consumerId      String    @unique
  consumer        Consumer  @relation(fields: [consumerId], references: [id])
  balance         Int       @default(0)
  lifetimeEarned  Int       @default(0)
  checkinStreak   Int       @default(0) // 연속 출석한 주 수
  lastCheckinWeek String? // 마지막 출석 ISO 주 (예: "2026-W37")
  lastCheckinAt   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  entries     PointLedgerEntry[]
  redemptions RewardRedemption[]
}

model PointLedgerEntry {
  id           String       @id @default(cuid())
  sequence     Int          @unique @default(autoincrement())
  accountId    String
  account      PointAccount @relation(fields: [accountId], references: [id])
  reason       PointReason
  amount       Int // + 적립 / - 차감
  balanceAfter Int
  memo         String?
  // 중복 적립 방지 멱등키 (예: "reg:<uidId>", "checkin:<week>", "survey:<surveyId>")
  dedupeKey    String?      @unique
  refType      String?
  refId        String?
  createdAt    DateTime     @default(now())

  @@index([accountId, createdAt])
}

model Survey {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  points      Int
  category    String   @default("GENERAL") // 마케팅 분석 태깅
  questions   Json // [{ id, text, type: 'single'|'multi'|'scale'|'text', options?: [] }]
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  responses SurveyResponse[]
}

model SurveyResponse {
  id         String   @id @default(cuid())
  surveyId   String
  survey     Survey   @relation(fields: [surveyId], references: [id])
  consumerId String
  consumer   Consumer @relation(fields: [consumerId], references: [id])
  answers    Json
  awarded    Int
  createdAt  DateTime @default(now())

  @@unique([surveyId, consumerId])
}

model Reward {
  id          String     @id @default(cuid())
  slug        String     @unique
  title       String
  description String
  cost        Int
  type        RewardType
  stock       Int? // null = 무제한
  active      Boolean    @default(true)
  sortOrder   Int        @default(0)
  createdAt   DateTime   @default(now())

  // DISCOUNT 타입일 때만 사용 — 할인 방식과 값
  discountKind  DiscountKind?
  discountValue Int?

  redemptions RewardRedemption[]
  coupons     Coupon[]
}

model RewardRedemption {
  id          String           @id @default(cuid())
  rewardId    String
  reward      Reward           @relation(fields: [rewardId], references: [id])
  accountId   String
  account     PointAccount     @relation(fields: [accountId], references: [id])
  consumerId  String
  consumer    Consumer         @relation(fields: [consumerId], references: [id])
  cost        Int
  status      RedemptionStatus @default(REQUESTED)
  createdAt   DateTime         @default(now())
  fulfilledAt DateTime?

  @@index([consumerId])
}

// 현장 단속 조회 기록. 조서를 발행한 건은 reportNumber가 부여된다.
model FieldInspection {
  id      String       @id @default(cuid())
  uidCode String
  uidId   String?
  uid     Uid?         @relation(fields: [uidId], references: [id])
  verdict FieldVerdict
  rule    String
  basis   String

  officerName String
  location    String

  // 조서에 첨부되는 원장 스냅샷 — 앵커링된 Merkle Root이므로 제3자 검증이 가능하다.
  ledgerSnapshot String?

  reportNumber String?   @unique
  reportedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([verdict])
}

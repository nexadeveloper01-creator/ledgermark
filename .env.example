DATABASE_URL="postgresql://ledgermark:ledgermark@localhost:5432/ledgermark?schema=public"

# 앵커링 모드
#   simulated : 퍼블릭 체인에 게시하지 않고 데모용 앵커 기록만 생성 (기본값)
#   chain     : 실제 퍼블릭 체인에 게시 — 가스비가 있는 지갑 키 필요
#   disabled  : 로컬 Merkle 루트만 계산
ANCHOR_MODE="simulated"

# chain 모드에서만 사용
# baseSepolia | polygonAmoy | base | polygon
ANCHOR_CHAIN="baseSepolia"
# 기본 공개 RPC 대신 전용 엔드포인트를 쓸 때만 지정
ANCHOR_RPC_URL=""
# 앵커링 전용 지갑의 개인키(0x...). 가스비 이외의 자산을 보관하지 말 것.
ANCHOR_PRIVATE_KEY=""

# 앵커링 주기 자동화
# 외부 스케줄러가 POST /api/ledger/anchor/cron 호출 시 사용할 공유 시크릿.
# 비워두면 자동 앵커링 엔드포인트가 비활성화된다.
ANCHOR_CRON_SECRET=""
# 미앵커 트랜잭션이 이 건수 이상이면 즉시 앵커링
ANCHOR_MIN_BATCH="50"
# 건수가 부족해도 이 시간을 넘기면 앵커링
ANCHOR_MAX_DELAY_MINUTES="60"
# npm run anchor:worker 사용 시 실행 주기
ANCHOR_WORKER_INTERVAL_SEC="60"
